# SDD Framework — technology-neutral ignores for a documentation/tooling repository.
# Language-specific or application-stack ignores belong in consuming projects.

# Operating system
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE user state (do not ignore assets/cursor/, .cursor/commands, or .cursor/skills)
# assets/cursor/ is the published sdd-* source when those files exist.
# This repository's .cursor/ holds vendor OpenSpec assets, not the published sdd-* tree.
.idea/
*.swp
*.swo
*~
.vscode/

# Local environment
.env
.env.*
!.env.example

# Temporary files and logs
*.log
*.tmp
tmp/
temp/

# Accidental key material
*.pem
*.key
